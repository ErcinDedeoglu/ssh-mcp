{
  "name": "ssh-mcp-cli",
  "version": "1.1.4",
  "description": "Dual-mode SSH automation: MCP server and CLI (exec, transfers, port forwarding, background jobs)",
  "main": "dist/index.js",
  "bin": {
    "ssh-mcp": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErcinDedeoglu/ssh-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ErcinDedeoglu/ssh-mcp/issues"
  },
  "homepage": "https://github.com/ErcinDedeoglu/ssh-mcp#readme",
  "scripts": {
    "build": "tsc",
    "test": "vitest --run tests/unit/**",
    "test:watch": "vitest --watch tests/unit/**",
    "test:coverage": "vitest --coverage tests/unit/**",
    "test:e2e": "./scripts/run-e2e-parallel.sh",
    "test:e2e:sequential": "SHARDS=1 ./scripts/run-e2e-parallel.sh",
    "test:e2e:run": "vitest --run tests/e2e/**",
    "test:e2e:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:e2e:down": "docker compose -f docker-compose.test.yml down",
    "test:all": "bun run test && bun run test:e2e",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' && prettier --check 'src/**/*.ts' 'tests/**/*.ts' && tsc --noEmit -p tsconfig.eslint.json",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix && prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "prepublishOnly": "bun run build && bun run test",
    "prepare": "node scripts/prepare.mjs"
  },
  "keywords": [
    "ssh",
    "mcp",
    "cli",
    "model-context-protocol",
    "remote-execution",
    "sftp",
    "port-forwarding"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.17.1",
    "commander": "^15.0.0",
    "ssh2": "^1.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ssh2": "^1.15.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
