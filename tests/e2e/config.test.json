{
  "$schema": "../../config.schema.json",
  "servers": [
    {
      "id": "test-server-1",
      "host": "localhost",
      "port": 2222,
      "username": "testuser",
      "auth": {
        "password": "testpass123"
      },
      "description": "Test SSH Server 1 (password auth)"
    },
    {
      "id": "test-server-2",
      "host": "localhost",
      "port": 2223,
      "username": "admin",
      "auth": {
        "password": "admin456"
      },
      "description": "Test SSH Server 2 (password auth)"
    },
    {
      "id": "jump-target-internal",
      "host": "ssh-mcp-test-2",
      "port": 2222,
      "username": "admin",
      "auth": {
        "password": "admin456"
      },
      "description": "Server 2 via Docker internal hostname (for jump host tests)"
    },
    {
      "id": "test-server-key",
      "host": "localhost",
      "port": 2224,
      "username": "keyuser",
      "auth": {
        "privateKey": "./tests/e2e/keys/test_key"
      },
      "description": "Test SSH Server 3 (key auth, no passphrase)"
    },
    {
      "id": "test-server-key-passphrase",
      "host": "localhost",
      "port": 2224,
      "username": "keyuser",
      "auth": {
        "privateKey": "./tests/e2e/keys/test_key_passphrase",
        "passphrase": "testpassphrase123"
      },
      "description": "Test SSH Server 3 (key auth, with passphrase)"
    }
  ],
  "defaults": {
    "timeouts": {
      "connection": 10,
      "command": 30,
      "idle": 300
    }
  }
}
